# Copy to .env and fill in. Never commit the real .env.
# deploy/setup_server.sh writes this file for you with fresh random secrets.

# Public address of the website (no trailing slash). Also used for the Claude connector and the SEO build.
PUBLIC_BASE_URL=https://codixa.tech
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Extra hosts besides the PUBLIC_BASE_URL domain and its www. (comma separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Django admin path — keep it hard to guess in production, e.g. control-8f2k1q/
DJANGO_ADMIN_URL=django-admin/
# PostgreSQL in production; leave empty to use SQLite for local development.
DATABASE_URL=postgres://codixa:password@127.0.0.1:5432/codixa
# Fernet key for encrypting project credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored credentials unreadable — back it up.
FIELD_ENCRYPTION_KEY=
# Frontend origins allowed to call the API from another domain (not needed when site and API share the domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Redis cache — required in production so login limits and caches are shared by all Gunicorn workers.
REDIS_URL=redis://127.0.0.1:6379/1
# Re-encode uploaded videos right after upload in a background thread (true) or only via the
# `transcode_videos` management command / cron (false).
VIDEO_TRANSCODE_INLINE=true

# E-mail notifications for new store bookings and contact messages.
# Gmail: Google account → Security → 2-Step Verification (on) → App passwords → create one for "Codixa".
# Put your Gmail address in EMAIL_HOST_USER and the 16-letter app password (no spaces) in EMAIL_HOST_PASSWORD.
# Leave EMAIL_HOST empty to keep e-mails queued (they are sent once it is configured).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional sender shown to you, e.g. "Codixa Website <you@gmail.com>" (defaults to EMAIL_HOST_USER)
DEFAULT_FROM_EMAIL=
